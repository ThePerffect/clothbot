# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Публичный HTTPS-адрес, где доступен этот сервер (нужен для Mini App).
# Для локальной разработки: cloudflared tunnel --url http://localhost:8080
WEBAPP_URL=https://your-domain.example
# Модель вырезки: birefnet-general (лучшее качество), birefnet-general-lite (быстрее),
# isnet-general-use (самая лёгкая)
REMBG_MODEL=birefnet-general
DATA_DIR=data
PORT=8080
# Смещение часового пояса по умолчанию, минуты (180 = МСК)
DEFAULT_TZ_OFFSET=180
# Только для локальной отладки Mini App в браузере без Telegram:
# DEV_USER_ID=1
